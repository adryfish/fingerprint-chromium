+bool TryGetWebGLParameter(ScriptState* script_state,
+                          unsigned pname,
+                          bool is_webgl2,
+                          ScriptValue* out) {
+  // UNMASKED_* are extension-gated; let their case sites handle them via
+  // TryGetWebGLUnmaskedParameter() so spoofing only happens once the
+  // WEBGL_debug_renderer_info extension is enabled.
+  if (pname == kUnmaskedVendorWebgl || pname == kUnmaskedRendererWebgl) {
+    return false;
+  }
+  return LookupWebGLParameter(script_state, pname, is_webgl2, out);
+}
+
+bool TryGetWebGLUnmaskedParameter(ScriptState* script_state,
+                                  unsigned pname,
+                                  bool is_webgl2,
+                                  ScriptValue* out) {
+  return LookupWebGLParameter(script_state, pname, is_webgl2, out);
+}
+
+bool TryGetWebGLShaderPrecision(unsigned shader_type,
+                                unsigned precision_type,
+                                bool is_webgl2,
+                                int range[2],
+                                int* precision) {
+  const WebGLConfig* config = GetActiveWebGLConfig();
+  if (!config) {
+    return false;
+  }
+  const WebGLParamSet& params = ActiveParamSet(*config, is_webgl2);
+  for (const auto& e : params.prec) {
+    if (e.shader_type == shader_type && e.precision_type == precision_type) {
+      range[0] = e.range_min;
+      range[1] = e.range_max;
+      *precision = e.precision;
+      return true;
+    }
+  }
+  return false;
+}
+
+bool TryGetWebGLAntialias(bool is_webgl2, bool* antialias) {
+  const WebGLConfig* config = GetActiveWebGLConfig();
+  if (!config) {
+    return false;
+  }
+  *antialias = ActiveParamSet(*config, is_webgl2).antialias;
+  return true;
+}
+
+}  // namespace blink
