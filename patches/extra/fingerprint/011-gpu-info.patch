+// (--fingerprint given, platform is windows/macos, and not disabled via
+// --disable-spoofing=...gpu...).
+bool IsWebGLFingerprintEnabled();
+
+// Tries to produce a spoofed getParameter() value for |pname|. Returns true and
+// sets |*out| when |pname| is overridden by the active config; returns false
+// otherwise (the caller must fall back to the real implementation).
+// |is_webgl2| selects the WebGL1 vs WebGL2 parameter set.
+//
+// The extension-gated UNMASKED_VENDOR_WEBGL / UNMASKED_RENDERER_WEBGL params are
+// deliberately NOT handled here (this returns false for them); they are spoofed
+// at their case sites via TryGetWebGLUnmaskedParameter() so the upstream
+// "extension not enabled -> error" behavior is preserved.
+bool TryGetWebGLParameter(ScriptState* script_state,
+                          unsigned pname,
+                          bool is_webgl2,
+                          ScriptValue* out);
+
+// Like TryGetWebGLParameter() but also covers the UNMASKED_* strings. Call this
+// from inside the WEBGL_debug_renderer_info extension-gated case so spoofing
+// only happens once the extension is enabled.
+bool TryGetWebGLUnmaskedParameter(ScriptState* script_state,
+                                  unsigned pname,
+                                  bool is_webgl2,
+                                  ScriptValue* out);
+
+// Tries to override a getShaderPrecisionFormat() result. Returns true and fills
+// |range| (min,max) and |*precision| when overridden; false otherwise.
+bool TryGetWebGLShaderPrecision(unsigned shader_type,
+                                unsigned precision_type,
+                                bool is_webgl2,
+                                int range[2],
+                                int* precision);
+
+// Tries to override the antialias value reported by getContextAttributes().
+// Returns true and sets |*antialias| when overridden; false otherwise.
+bool TryGetWebGLAntialias(bool is_webgl2, bool* antialias);
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_WEBGL_FINGERPRINT_H_
