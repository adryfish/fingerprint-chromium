 #include "third_party/blink/public/common/device_memory/approximated_device_memory.h"
 #include "third_party/blink/public/mojom/use_counter/metrics/web_feature.mojom-shared.h"
 #include "third_party/blink/renderer/core/dom/document.h"
@@ -12,6 +14,18 @@
 namespace blink {
 
 float NavigatorDeviceMemory::deviceMemory() const {
+  const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+
+  // navigator.deviceMemory 的真实上限并非 8：按指纹 seed 从 {8, 16, 32, 64}
+  // 中确定性地选取一个值进行伪装。
+  if (command_line->HasSwitch(switches::kFingerprint)) {
+    std::string fingerprint_str =
+        command_line->GetSwitchValueASCII(switches::kFingerprint);
+    uint32_t fingerprint = static_cast<uint32_t>(std::stoull(fingerprint_str));
+    static const float kDeviceMemoryValues[] = {8, 16, 32, 64};
+    return kDeviceMemoryValues[fingerprint % 4];
+  }
+
   return ApproximatedDeviceMemory::GetApproximatedDeviceMemory();
 }
 
